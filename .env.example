# Clients send "Authorization: Bearer <this>". Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_API_KEY=
# Public hostname you route to this server in the Cloudflare tunnel, e.g. whatsapp.example.com
MCP_PUBLIC_HOST=
# Token from Cloudflare dashboard: Zero Trust > Networks > Tunnels > your tunnel
CLOUDFLARE_TUNNEL_TOKEN=
